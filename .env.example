ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Hostnames resolve on the Docker network (infra shared-postgres + minio).
# Settings assembles postgresql+asyncpg:// from these parts. DATABASE_URL is ignored.
DATABASE_HOST=shared-postgres
DATABASE_PORT=5432
DATABASE_USER=blob
DATABASE_PASSWORD=blob
DATABASE_NAME=blob

# --- Auth ---
# Legacy shared secret for /internal/v1/* (header X-Service-Api-Key). New callers
# use Authorization: Bearer bbk_... and derive the namespace from the key.
SERVICE_API_KEY=change-me-in-production
# Keep the X-Service-Api-Key + X-Blob-Namespace migration path enabled.
ALLOW_HEADER_NAMESPACE=true
# Secret for /admin/v1/* (header X-Admin-Api-Key) -- sets per-namespace limits.
ADMIN_API_KEY=change-me-in-production
# Secret and cookie name for the session-authenticated HTML dashboard.
SESSION_SECRET=dev-insecure-change-me
SESSION_COOKIE_NAME=butter_blob_admin

# --- Object storage (S3 / MinIO) ---
AWS_REGION=us-east-1
S3_BUCKET=devbutter-blob-local
# Local dev points at the MinIO container; leave unset on AWS so boto3 talks to real S3.
S3_ENDPOINT_URL=http://minio:9000
# MinIO needs path-style addressing; real S3 uses virtual-hosted (set false on AWS).
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=900
# MinIO doesn't check these but boto3 refuses to sign without credentials.
# On AWS the ECS task role supplies credentials and these are unset.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- Async post-processing worker (SQS / ElasticMQ) ---
BLOB_JOBS_QUEUE_URL=http://elasticmq:9324/000000000000/blob-jobs
BLOB_JOBS_ENDPOINT_URL=http://elasticmq:9324
# Set CLAMAV_HOST to enable virus scans (for example: clamav).
CLAMAV_HOST=
CLAMAV_PORT=3310
# Comma-separated widths applied to image uploads by the worker.
THUMBNAIL_WIDTHS=256
ENABLE_VIDEO_TRANSCODE=false

# --- Limits ---
MAX_UPLOAD_BYTES=52428800
DEFAULT_TEMPORARY_TTL_SECONDS=86400
MAX_TEMPORARY_TTL_SECONDS=604800

# Base URL clients use to reach this service's public routes (used to build
# public_url in responses). In prod: https://blob.devbutter.tech
PUBLIC_BASE_URL=http://localhost:8003

# CDN in front of the private S3 bucket (prompt 15). When set, permanent public
# blobs are served as stable CloudFront object URLs (f"{PUBLIC_CDN_BASE_URL}/{key}")
# instead of short-lived presigned S3 URLs; temporary blobs always keep the
# presigned URL. CLOUDFRONT_DISTRIBUTION_ID enables edge invalidation on
# delete / visibility->private / content replace. Leave both empty in local dev.
PUBLIC_CDN_BASE_URL=
CLOUDFRONT_DISTRIBUTION_ID=

# --- CloudWatch EMF metrics ---
AWS_EMF_NAMESPACE=DevButter/ButterBlob
AWS_EMF_SERVICE_NAME=butter-blob
AWS_EMF_LOG_GROUP_NAME=/ecs/devbutter/staging/blob
# Must stay "Local" everywhere (dev and ECS): metrics ship via the awslogs log
# driver -> CloudWatch Logs auto-extraction, not a CloudWatch Agent sidecar.
# Leaving this unset makes the library fall back to the "Agent" TCP sink, which
# silently drops every metric.
AWS_EMF_ENVIRONMENT=Local
